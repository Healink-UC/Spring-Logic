spring:
  datasource:
    url: jdbc:h2:mem:testdb
    driverClassName: org.h2.Driver
    username: [username]
    password: [password]
  jpa:
    hibernate:
      ddl-auto: create-drop
    properties:
      hibernate:
        dialect: org.hibernate.dialect.H2Dialect
        show_sql: false
        format_sql: false
  h2:
    console:
      enabled: true

logging:
  level:
    com.healink.integrador: DEBUG
    org.springframework.security: DEBUG